	<groupId>com.c4sstudio</groupId>
	<artifactId>c4s-studio-paypal</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>C4S Studio PayPal Checkout</name>
	<description>C4S Studio website backend with real PayPal Checkout integration</description>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>com.paypal.sdk</groupId>
			<artifactId>paypal-server-sdk</artifactId>
			<version>1.0.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
